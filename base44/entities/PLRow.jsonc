{
  "name": "PLRow",
  "type": "object",
  "properties": {
    "statement_id": {
      "type": "string",
      "description": "ID of the related PLStatement record"
    },
    "label": {
      "type": "string",
      "description": "Line item name, e.g. 'Employee Labor'"
    },
    "section": {
      "type": "string",
      "enum": [
        "Income",
        "Cost of Goods Sold",
        "Expenses",
        "Summary"
      ],
      "description": "P&L section this row belongs to"
    },
    "parent_label": {
      "type": "string",
      "description": "Label of the parent group if this is a sub-item, e.g. 'Labor' or 'Payroll Expenses'"
    },
    "row_type": {
      "type": "string",
      "enum": [
        "group_header",
        "item",
        "subtotal",
        "total"
      ],
      "description": "Type of row"
    },
    "indent_level": {
      "type": "number",
      "description": "Indentation level: 0, 1, or 2"
    },
    "monthly_values": {
      "type": "string",
      "description": "JSON string mapping YYYY-MM keys to amounts, e.g. {\"2026-01\": 44238.44, \"2026-02\": 88339.58}"
    },
    "total_value": {
      "type": "number",
      "description": "The Total column value from QuickBooks"
    }
  },
  "required": [
    "statement_id",
    "label",
    "section",
    "row_type"
  ]
}