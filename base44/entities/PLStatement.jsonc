{
  "name": "PLStatement",
  "type": "object",
  "properties": {
    "period_label": {
      "type": "string",
      "description": "Human-readable period label, e.g. 'Q1 2026', 'Jan 2026'"
    },
    "period_start": {
      "type": "string",
      "description": "Start of period in YYYY-MM format, e.g. '2026-01'"
    },
    "period_end": {
      "type": "string",
      "description": "End of period in YYYY-MM format, e.g. '2026-03'"
    },
    "year": {
      "type": "number",
      "description": "Fiscal year, e.g. 2026"
    },
    "quarter": {
      "type": "string",
      "description": "Quarter label e.g. 'Q1', 'Q2', or null if not a full quarter"
    },
    "months": {
      "type": "string",
      "description": "Comma-separated list of months in this statement, e.g. '2026-01,2026-02,2026-03'"
    },
    "filename": {
      "type": "string",
      "description": "Original uploaded filename"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date",
      "description": "Date the file was uploaded"
    }
  },
  "required": [
    "period_label",
    "period_start",
    "period_end",
    "year"
  ]
}